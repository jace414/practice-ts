{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node", "vitest"],
        "paths": {
            "#src/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.test.ts"]
}
